{
  "name": "juguem-i-aprenc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Juego educativo multiplataforma para niños de 4 y 5 años",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
