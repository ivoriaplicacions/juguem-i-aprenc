    "cap:ios": "npm run cap:sync && npx cap open ios",
    "desktop": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "main": "electron/main.cjs"
}
